<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization Header to Node.js
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # If request is an existing static asset (in assets, icons, etc), serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else (API routes, SPA pages) forward to Node.js index.js
  RewriteRule ^(.*)$ index.js [L,QSA]
</IfModule>
